.env.local
.env*.local
node_modules/
.next/
out/
*.tsbuildinfo
.vercel
.DS_Store

# Generated pack assets (large binaries — not source)
packs/*/images/
packs/*/preview-grid.png
packs/*/_grid.html
packs/*.zip

# Product recipe and go-to-market — kept local, not published.
packs/gen.mjs
packs/gridall.mjs
packs/DISTRIBUTION.md
packs/UPLOAD.md
packs/*.png
packs/*/
!packs/*/manifest.json

# Generated ambassador output and model caches — local only.
packs/ambassador-out/
.hfcache/
.insightface/

# Identity Kit images are generated output, not source.
packs/characters/*/accepted/
packs/characters/*/rejected/
packs/flux-out/
packs/flux-v2/
packs/flux-faces/
packs/seraphinne-v1/
packs/seraphinne/
packs/*.log
packs/characters/*/cache/
packs/seraphinne-lora/
packs/seraphinne-final/
packs/seraphinne-v2/
packs/qc/

.vercel

# Compose env — holds HF_TOKEN.
.env
.n8n/
.searxng/

# Python — virtualenvs, caches, build output. Repo-wide rather than scoped to
# engine/, because oss/ packages are separate distributions with their own
# caches and a scoped rule silently stops covering the next one.
.venv/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
**/dist/
.omnex/
